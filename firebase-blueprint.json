{
  "entities": {
    "AuditBlock": {
      "title": "AuditBlock",
      "description": "A cryptographic block representing a decision or state change in the engine.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["SYSTEM", "AGENT", "MARKET", "TRADE"] },
        "data": { "type": "object" },
        "previousHash": { "type": "string" },
        "hash": { "type": "string" },
        "index": { "type": "number" }
      },
      "required": ["timestamp", "type", "data", "previousHash", "hash", "index"]
    },
    "EngineConfig": {
      "title": "EngineConfig",
      "description": "Global configuration for the engine.",
      "type": "object",
      "properties": {
        "isKillSwitchActive": { "type": "boolean" },
        "maxTradesPerDay": { "type": "number" },
        "lastHash": { "type": "string" },
        "brokerApiKey": { "type": "string" },
        "brokerAccessToken": { "type": "string" }
      }
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A cryptographically chained learning entry derived from trade outcomes.",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "tradeId": { "type": "string" },
        "outcome": { "type": "string", "enum": ["WIN", "LOSS"] },
        "reasonForLoss": { "type": "string" },
        "agentCorrection": { "type": "string" },
        "confidence": { "type": "number" },
        "previousHash": { "type": "string" },
        "hash": { "type": "string" }
      },
      "required": ["index", "timestamp", "tradeId", "outcome", "reasonForLoss", "previousHash", "hash"]
    }
  },
  "firestore": {
    "/ledger": {
      "schema": "AuditBlock",
      "description": "The immutable cryptographic ledger of all engine decisions."
    },
    "/config": {
      "schema": "EngineConfig",
      "description": "Engine configuration and state tracking."
    },
    "/lessons": {
      "schema": "Lesson",
      "description": "Stored cognitive improvements for future AI inference."
    },
    "/state": {
      "schema": {
        "title": "EngineStatePersistence",
        "description": "Snapshots of AI interpretation to prevent empty dashboard states.",
        "type": "object",
        "properties": {
          "agentReports": { "type": "array" },
          "bfsiReport": { "type": "object" },
          "apexSignals": { "type": "array" },
          "marketBiasScore": { "type": "number" },
          "consensus": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Resilient cache of intelligence state."
    }
  }
}
