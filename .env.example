# ---- Server only. Never put these in VITE_ variables (those reach the browser).

# Owner login allowed to use the dashboard and controls
ADMIN_EMAIL=chijobha@gmail.com

# Claude (Anthropic) writes the daily brief. Leave empty to turn briefs off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Brain schedule on always-on hosts (minutes). Serverless hosts call /api/cron.
RUN_EVERY_MIN=5
# Secret for /api/cron (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Storage: Firestore (default, via Firebase Admin credentials) or "file" for data/brain-state.json
BRAIN_STORE=
# Firebase Admin credentials (path to a service-account JSON), needed for Firestore on non-Google hosts
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Live trading (Dhan). Off unless LIVE_TRADING_ENABLED=true AND you press "Go live".
LIVE_TRADING_ENABLED=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
RISK_PER_TRADE_INR=2000
MAX_LIVE_TRADES_PER_DAY=1
DAILY_LOSS_LIMIT_INR=4000
MAX_CAPITAL_PER_TRADE_INR=100000

# ---- Public Firebase web config (safe in the browser; used for Google sign-in only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
