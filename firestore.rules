rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The browser only signs in. All engine data is read and written by the
    // server through the Admin SDK, which these rules do not restrict.

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "chijobha@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Read-only views for the owner (audit trail and engine data)
    match /ledger/{blockId} { allow read: if isOwner(); allow write: if false; }
    match /brain/{docId} { allow read: if isOwner(); allow write: if false; }
    match /brain_trades/{docId} { allow read: if isOwner(); allow write: if false; }
    match /brain_predictions/{docId} { allow read: if isOwner(); allow write: if false; }

    // Broker keys must never be stored in the database
    match /config/{configId} { allow read, write: if false; }

    // Everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
